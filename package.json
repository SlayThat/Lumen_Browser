{
  "name": "lumen-browser",
  "productName": "Lumen",
  "version": "0.3.1",
  "description": "Lumen: a Chromium-based browser with a Liquid Glass style toolbar.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --publish never",
    "test": "node test/netfilter.test.js && node test/store.test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.lumen.browser",
    "productName": "Lumen",
    "copyright": "Copyright (c) Lumen",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Lumen-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Lumen",
      "include": "build/installer.nsh",
      "perMachine": false
    },
    "portable": {
      "artifactName": "Lumen-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "A web browser with a Liquid Glass toolbar",
      "maintainer": "SlayThat <slaythat@users.noreply.github.com>",
      "executableName": "lumen-browser",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "artifactName": "Lumen-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SlayThat",
        "repo": "Lumen_Browser"
      }
    ]
  },
  "author": "SlayThat",
  "license": "MIT",
  "homepage": "https://github.com/SlayThat/Lumen_Browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/SlayThat/Lumen_Browser.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "desktopName": "lumen-browser.desktop"
}
